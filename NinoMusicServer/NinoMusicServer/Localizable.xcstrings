    "%@" : {
      "comment" : "A row in a sheet that shows a loading indicator and a label. The argument is the string “Músicas”, the string “Artistas”, the string “Álbuns” or the string “Tag Editor”.",
      "isCommentAutoGenerated" : true
    },
    "%lld" : {

    },
    "%lld musica(s)." : {
      "comment" : "A label showing the number of music files in a given directory. The argument is the number of music files in the directory.",
      "isCommentAutoGenerated" : true
    },
